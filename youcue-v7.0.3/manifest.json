{
  "manifest_version": 3,
  "name": "YouCue",
  "version": "7.0.3",
  "description": "YouCue turns YouTube into a cue-and-loop sampler with performance recording, MP3 cue export, note repeat, timeline markers, and per-video saved cues.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "tabCapture",
    "offscreen",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouCue"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  }
}